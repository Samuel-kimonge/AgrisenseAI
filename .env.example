# Copy to .env and edit. Never commit .env.

# --- LLM provider for the assistant: none | anthropic | openai | ollama
# "none" = no generation; the assistant returns grounded extracts from the knowledge base.
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2

# --- Embeddings: hashing (offline, no download) | sentence-transformers (needs Hugging Face access)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- RAG tuning
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_K=4
MIN_RELEVANCE=0.30

# --- ML / uploads
IMAGE_SIZE=192
MAX_UPLOAD_MB=8
TORCH_THREADS=2

# --- Optional path overrides
# DATABASE_PATH=data/agrisense.db
# RAW_DATA_DIR=data/raw/plantvillage_tomato
